[Unit]
Description=SlimeFi game server (Flask + SQLite)
After=network.target

[Service]
WorkingDirectory=/home/hatch/workspace/slimefi-project
EnvironmentFile=-/home/hatch/workspace/slimefi-project/.env
ExecStart=/home/hatch/workspace/slimefi-project/venv/bin/python /home/hatch/workspace/slimefi-project/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
